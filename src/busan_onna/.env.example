#--------------------------------------------------------------------
# ENVIRONMENT
# development | production | testing
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
# 실제 도메인 또는 서버 IP로 변경
#--------------------------------------------------------------------
app.baseURL = 'http://your-domain-or-ip/'
app.indexPage = ''

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = busan_onna
database.default.username = busan_user
database.default.password = 비밀번호_입력
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port     = 3306
database.default.charset  = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# KAKAO MAP API
# https://developers.kakao.com 내 애플리케이션 > 앱 키 > JavaScript 키
# 앱 설정 > 플랫폼 > Web 에 서비스 도메인 등록 필수
#--------------------------------------------------------------------
KAKAO_MAP_JS_KEY=발급키_입력
