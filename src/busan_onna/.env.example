#--------------------------------------------------------------------
# ENVIRONMENT
# development | production | testing
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
# 실제 도메인 또는 서버 IP로 변경
#--------------------------------------------------------------------
app.baseURL = 'http://your-domain-or-ip/'
app.indexPage = ''

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = busan_onna
database.default.username = busan_user
database.default.password = 비밀번호_입력
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port     = 3306
database.default.charset  = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# KAKAO MAP API
# https://developers.kakao.com 내 애플리케이션 > 앱 키 > JavaScript 키
# 앱 설정 > 플랫폼 > Web 에 서비스 도메인 등록 필수
#--------------------------------------------------------------------
KAKAO_MAP_JS_KEY=발급키_입력

#--------------------------------------------------------------------
# DB 백업 스케줄러 (php spark db:backup)
#--------------------------------------------------------------------
# mysqldump 실행 파일 경로. 서버(Linux)에서 PATH에 mysqldump가 있으면 비워두거나 생략 가능(기본값 mysqldump).
# 로컬 Windows에서 PATH에 없다면 전체 경로를 지정.
# 예) DB_BACKUP_MYSQLDUMP_PATH="C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe"
DB_BACKUP_MYSQLDUMP_PATH=mysqldump

# writable/backup/ 에 보관할 일수. 이 기간이 지난 db_*.sql 파일은 자동 삭제됨. 0으로 두면 자동 삭제 비활성화.
DB_BACKUP_RETENTION_DAYS=30
